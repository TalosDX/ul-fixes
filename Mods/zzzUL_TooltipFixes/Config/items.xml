	<append xpath="/items/item[@name='drugRecog']"><effect_group tiered="false"><display_value name="dThirstRate" value="7.2" /></effect_group></append>
	<!-- Jail Breakers: lockpick durability +200%, break chance perc_subtract 2 (lockpicks do not break) -->
	<append xpath="/items/item[@name='drugJailBreakers']"><effect_group tiered="false"><display_value name="dLockPickDurability" value="2" /><display_value name="dLockPickBreak" value="-1" /></effect_group></append>
	<!-- Hackers / Rock Busters: -5% harvesting XP -->
	<append xpath="/items/item[@name='drugHackers']"><effect_group tiered="false"><display_value name="dHarvestExp" value="-.05" /></effect_group></append>
	<append xpath="/items/item[@name='drugRockBusters']"><effect_group tiered="false"><display_value name="dHarvestExp" value="-.05" /></effect_group></append>
	<!-- Mega Crush: +120% water used per stamina point -->
	<append xpath="/items/item[@name='drinkCanMegaCrush']"><effect_group tiered="false"><display_value name="dWaterPerStamina" value="1.2" /></effect_group></append>
	<!-- Coffee jar: the tooltip shows dResistCold, the item only had dHypothermalResist -->
	<append xpath="/items/item[@name='drinkJarCoffee']"><effect_group tiered="false"><display_value name="dResistCold" value="5" /></effect_group></append>
	<!-- Plastic bottle drinks used the plain water tooltip, hiding their buffs -->
	<append xpath="/items/item[@name='ulmDrinkPlasticBottleBeer']"><property name="DisplayType" value="waterBeer" /></append>
	<append xpath="/items/item[@name='ulmDrinkPlasticBottleCoffee']"><property name="DisplayType" value="waterCoffee" /></append>
	<append xpath="/items/item[@name='ulmDrinkPlasticBottleMineralWater']"><property name="DisplayType" value="waterGoldenrodRedTea" /></append>
	<!-- Miner helmet used the generic mod tooltip (no armor stats) -->
	<set xpath="/items/item[@name='armorMinerHelmet']/property[@name='DisplayType']/@value">armorMedium</set>
</configs>
